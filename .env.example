# ==============================================================================
# SurfZone Networks — environment (Stormclouds Digital)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ==============================================================================

# ---- MySQL (used by the `db` service AND by Django) --------------------------
# ROTATE THESE — the old values were committed to git and are compromised.
DB_ROOT_PASSWORD=change-me-strong-root-password
DB_NAME=surfzone_db
DB_USER=surfzone_user
DB_PASSWORD=change-me-strong-user-password
DB_HOST=db
DB_PORT=3306

# ---- Django core -------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=false

# Public domain served through Cloudflare (no scheme).
PRODUCTION_DOMAIN=surfzone.stormclouds.co.ke
PRODUCTION_FRONTEND_URL=https://surfzone.stormclouds.co.ke
BASE_URL=https://surfzone.stormclouds.co.ke
PAYMENT_APP_BASE_URL=https://surfzone.stormclouds.co.ke

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- Email (optional, SendGrid) ---------------------------------------------
# SENDGRID_API_KEY=
# FROM_EMAIL=support@stormclouds.co.ke

# ---- MPesa (fill from your Daraja app before taking payments live) ----------
# MPESA_ENCRYPTION_KEY=
